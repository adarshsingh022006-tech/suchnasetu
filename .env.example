# =================================================================
# SUCHNASETU CONFIGURATION
# SHINCHAN ONLINE HACKATHON 2026
# Problem Statement: DIGITAL DARK SPOT – AI-Assisted Information Gap Detection
# =================================================================

# Server Port (Default: 5001)
PORT=5001
NODE_ENV=development

# Database (Optional)
# If left empty, SuchnaSetu runs in zero-configuration In-Memory Demo Storage
MONGODB_URI=

# AI Engine (Optional)
# If left empty, SuchnaSetu uses its built-in deterministic heuristic NLP engine
# Provide a valid Google Gemini API key to activate Gemini 2.5 structured claim extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

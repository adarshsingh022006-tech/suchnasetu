# SUCHNASETU - ENVIRONMENT CONFIGURATION
# SHINCHAN ONLINE HACKATHON 2026
# Problem Statement: DIGITAL DARK SPOT – AI-Assisted Information Gap Detection Platform

PORT=5001
NODE_ENV=development

# Database Configuration (Optional)
# If empty or invalid, SuchnaSetu runs in Zero-Dependency In-Memory Demo Mode
MONGODB_URI=

# AI Engine Configuration (Optional)
# If empty, SuchnaSetu utilizes its built-in deterministic heuristic NLP intelligence engine
# Provide a valid Gemini API key to enable live LLM structured claim extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
